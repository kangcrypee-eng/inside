# 인사이드 환경변수 예시 — 복사해서 .env.local 로 사용 (.env.local 은 git 제외)
# 실제 값은 D+1 Supabase 프로젝트 생성 후 채운다.

# Supabase (브라우저 노출 OK — anon 키)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role — 서버 전용 (절대 NEXT_PUBLIC_ 접두어 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude Haiku — 요청서 텍스트 자동 정리 (서버 전용)
ANTHROPIC_API_KEY=

# Toss Payments — D+15 결제 활성화 시 사용
TOSS_CLIENT_KEY=
# Toss 시크릿 — 서버 API route 전용
TOSS_SECRET_KEY=
